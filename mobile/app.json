{
  "expo": {
    "name": "EdLight Academy",
    "slug": "edlight-academy",
    "version": "1.6.0",
    "runtimeVersion": "1.2.0",
    "updates": {
      "url": "https://u.expo.dev/84d5c2a1-53bc-443c-8a93-e17a1207322b",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "_note_assets": "Run: npx expo install and then generate assets with: npx expo-doctor. Placeholder PNGs can be 1024x1024 for icon and 1284x2778 for splash.",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.edlightacademy",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.618990331083-7snnbt287h2k9b82mkoufloj6um0epl4"
            ]
          }
        ]
      },
      "associatedDomains": [
        "applinks:academy.edlight.org"
      ],
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.edlightacademy",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "academy.edlight.org",
              "pathPrefix": "/defi"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 98,
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0b1220"
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0857A6"
        }
      ],
      "react-native-bottom-tabs"
    ],
    "scheme": "edlight",
    "extra": {
